COMPOSE_PARALLEL_LIMIT=1
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=server=host.docker.internal;port=3306;database=tlalocai_databse;user=tlalocai;password=TlalocaiApp123!
