FROM node:20-alpine AS build
WORKDIR /app

ARG VITE_API_BASE_URL=
ARG VITE_IDENTITY_API_BASE_URL=
ARG VITE_DEVICES_API_BASE_URL=
ARG VITE_TELEMETRY_API_BASE_URL=
ARG VITE_CONTROL_API_BASE_URL=
ARG VITE_ANALYTICS_API_BASE_URL=
ARG VITE_USE_GATEWAY=true

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_IDENTITY_API_BASE_URL=$VITE_IDENTITY_API_BASE_URL
ENV VITE_DEVICES_API_BASE_URL=$VITE_DEVICES_API_BASE_URL
ENV VITE_TELEMETRY_API_BASE_URL=$VITE_TELEMETRY_API_BASE_URL
ENV VITE_CONTROL_API_BASE_URL=$VITE_CONTROL_API_BASE_URL
ENV VITE_ANALYTICS_API_BASE_URL=$VITE_ANALYTICS_API_BASE_URL
ENV VITE_USE_GATEWAY=$VITE_USE_GATEWAY

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:alpine AS production
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
