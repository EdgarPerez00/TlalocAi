{
  "Agent": {
    "DeviceId": "raspberry-main-001",
    "SiteId": "escom-demo",
    "Mode": "Simulation",
    "Version": "1.0.0"
  },
  "Backend": {
    "BaseUrl": "https://TU_BACKEND_EN_NUBE",
    "ApiKey": "CHANGE_ME",
    "HeartbeatIntervalSeconds": 10,
    "TelemetryIntervalSeconds": 2,
    "CommandPollingIntervalMilliseconds": 1000,
    "UseSignalR": false
  },
  "Gpio": {
    "NumberingScheme": "BCM"
  },
  "Tower": {
    "LevelSensorPins": [5, 6, 13, 19, 26],
    "PumpOutputPin": 17,
    "MinLevelToRun": 2,
    "UnlockLevel": 3
  },
  "Cistern": {
    "LevelSensorPins": [12, 16, 20, 21, 25],
    "PumpOutputPin": 27,
    "MinLevelToRun": 2,
    "MaxLevelToRun": 5,
    "UnlockLevel": 3
  },
  "FlowSensor": {
    "Pin": 23,
    "PulsesPerLiter": 450,
    "NoFlowTimeoutSeconds": 5
  },
  "Esp32Boards": [
    {
      "BoardId": "esp32-a",
      "SerialPort": "/dev/ttyUSB0",
      "BaudRate": 115200,
      "ContainerStatusInputPinsOnRaspberry": [4, 18, 22, 24],
      "ControlsValves": [1, 2],
      "ControlsContainers": [1, 2, 3, 4]
    },
    {
      "BoardId": "esp32-b",
      "SerialPort": "/dev/ttyUSB1",
      "BaudRate": 115200,
      "ContainerStatusInputPinsOnRaspberry": [10, 9, 11, 8],
      "ControlsValves": [3, 4],
      "ControlsContainers": [5, 6, 7, 8]
    }
  ],
  "Safety": {
    "CloseValvesWhenTowerCritical": true,
    "StopPumpWhenNoFlow": true,
    "RejectUnsafeCommands": true
  }
}
